#!/usr/bin/env bash
# horos — CLI to declare scope, toggle enforcement, externalize decisions, deposit claims,
# wire multi-harness installs (claude | agy | codex), prune runtime logs, and diagnose health.
set -euo pipefail

# ROOT resolution (D13, D14, D28): check HOROS_PROJECT_DIR -> CLAUDE_PROJECT_DIR -> git toplevel -> pwd.
if [ -n "${HOROS_PROJECT_DIR:-}" ]; then
  ROOT="${HOROS_PROJECT_DIR%/}"; [ -n "$ROOT" ] || ROOT="/"; ROOT_SRC=env
elif [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
  ROOT="${CLAUDE_PROJECT_DIR%/}"; [ -n "$ROOT" ] || ROOT="/"; ROOT_SRC=env
elif ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" && [ -n "$ROOT" ]; then
  ROOT_SRC=git
else
  ROOT="$(pwd)"; ROOT_SRC=pwd
fi

# CENTRAL = where this script lives (distinct from ROOT, the target project).
CENTRAL="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd || printf '%s' "$ROOT")"
HERE="$CENTRAL/hooks"
S="$ROOT/.horos"; mkdir -p "$S"

read_mode() {
  local m=""
  [ -f "$S/mode" ] && m="$(tr -d '[:space:]' < "$S/mode" 2>/dev/null)"
  case "$m" in warn|block|strict) printf '%s' "$m" ;; *) printf 'warn' ;; esac
}

warn_root() {
  if [ "$ROOT_SRC" = pwd ]; then
    echo "notice: HOROS-CLI-ROOT root=$ROOT (CLAUDE_PROJECT_DIR unset, CWD is not a git repo). If this is the wrong project, cd to the project root or export CLAUDE_PROJECT_DIR, then rerun." >&2
  fi
}

HOROS_BASENAMES="scope-guard.sh reversibility-guard.sh finish-the-work.sh decision-guard.sh claim-guard.sh parent-bridge.sh session-brief.sh"
export HOROS_BASENAMES

cmd="${1:-help}"; shift || true
case "$cmd" in
  scope)
    sub="${1:-show}"; shift || true
    case "$sub" in
      set)
        [ "$#" -ge 1 ] || { echo "usage: horos scope set <glob>..." >&2; exit 1; }
        warn_root
        HOROS_S="$S" python3 - "$@" <<'PY'
import datetime, json, os, sys
allow = sys.argv[1:]
path = os.path.join(os.environ["HOROS_S"], "scope.json")
with open(path, "w", encoding="utf-8") as fh:
    json.dump({"allow": allow, "declared_at": datetime.datetime.now(datetime.timezone.utc).isoformat()},
              fh, ensure_ascii=False, indent=2)
    fh.write("\n")
PY
        echo "scope set: $* -> $S/scope.json" ;;
      show)  cat "$S/scope.json" 2>/dev/null || echo "(no scope declared)" ;;
      clear) rm -f "$S/scope.json"; echo "scope cleared" ;;
      *) echo "usage: horos scope set|show|clear" >&2; exit 1 ;;
    esac ;;

  mode)
    sub="${1:-show}"
    case "$sub" in
      warn|block|strict) warn_root; printf '%s\n' "$sub" > "$S/mode"; echo "mode = $sub -> $S/mode" ;;
      show|"")           echo "$(read_mode)" ;;
      *) echo "usage: horos mode warn|block|strict|show" >&2; exit 1 ;;
    esac ;;

  decide)
    id="${1:-}"; why="${2:-}"; cost="${3:-}"; esc="${4:-}"; files="${5:-}"
    if [ -z "$id" ] || [ -z "$why" ] || [ -z "$cost" ] || [ -z "$esc" ]; then
      echo "usage: horos decide D<n> <why> <cost> <escape> [files,csv]" >&2; exit 1; fi
    warn_root
    PYTHONPATH="$HERE" HOROS_LEDGER="$ROOT/decisions.jsonl" HID="$id" HWHY="$why" HCOST="$cost" HESC="$esc" HFILES="$files" HROOT="$ROOT" python3 - <<'PY'
import datetime, fcntl, json, os, re, shlex, sys
try:
    import horos_core
except Exception:
    horos_core = None

led = os.environ["HOROS_LEDGER"]; rid = os.environ["HID"]
ids = set()
try:
    with open(led, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line: continue
            try: r = json.loads(line)
            except Exception: continue
            if isinstance(r, dict) and r.get("id"): ids.add(str(r["id"]))
except FileNotFoundError:
    pass
def next_free(prefix):
    n = 0
    for i in ids:
        m = re.match("^" + prefix + r"([1-9][0-9]*)$", i)
        if m: n = max(n, int(m.group(1)))
    return "%s%d" % (prefix, n + 1)
example = "horos decide %s %s %s %s" % (next_free("D"), shlex.quote(os.environ["HWHY"]),
                                        shlex.quote(os.environ["HCOST"]), shlex.quote(os.environ["HESC"]))
if not re.match(r"^D[1-9][0-9]*$", rid):
    raise SystemExit("error: HOROS-CLI-BADID '%s' 는 D<n> 형식이 아닙니다 (not of the form D<n>; nothing was recorded). "
                     "Action: rerun with the suggested free id. 예: %s" % (rid, example))
if rid in ids:
    raise SystemExit("error: HOROS-CLI-DUPID %s 는 ledger에 이미 존재합니다 (already exists — appending again would silently shadow the original). "
                     "다음 빈 ID (next free): %s. Action: rerun with the suggested free id. 예: %s"
                     % (rid, next_free("D"), example))
missing = [x for x in os.environ.get("HFILES", "").split(",")
           if x and not os.path.exists(os.path.join(os.environ["HROOT"], x))]
if missing:
    print("warning: HOROS-CLI-NOFILE files not on disk (informational field, recorded anyway): "
          + ", ".join(missing), file=sys.stderr)
rec = {"id": rid, "why": os.environ["HWHY"], "cost": os.environ["HCOST"],
       "escape": os.environ["HESC"],
       "files": [x for x in os.environ.get("HFILES", "").split(",") if x],
       "date": datetime.datetime.now(datetime.timezone.utc).isoformat()}
raw = json.dumps(rec, ensure_ascii=False)
if horos_core:
    horos_core.locked_append(led, raw)
else:
    with open(led, "a", encoding="utf-8") as f:
        fcntl.flock(f.fileno(), fcntl.LOCK_EX)
        f.write(raw + "\n")
print("recorded %s -> %s" % (rec["id"], led))
PY
    ;;

  aporia)
    id="${1:-}"; poles="${2:-}"; why="${3:-}"; trig="${4:-}"; files="${5:-}"
    if [ -z "$id" ] || [ -z "$poles" ] || [ -z "$why" ] || [ -z "$trig" ]; then
      echo "usage: horos aporia A<n> \"<pole1>|<pole2>[|...]\" <why_unresolved> <trigger> [files,csv]" >&2; exit 1; fi
    warn_root
    PYTHONPATH="$HERE" HOROS_LEDGER="$ROOT/decisions.jsonl" HID="$id" HPOLES="$poles" HWHY="$why" HTRIG="$trig" HFILES="$files" python3 - <<'PY'
import datetime, fcntl, json, os, re, shlex
try:
    import horos_core
except Exception:
    horos_core = None

led = os.environ["HOROS_LEDGER"]; rid = os.environ["HID"]
ids = set()
try:
    with open(led, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line: continue
            try: r = json.loads(line)
            except Exception: continue
            if isinstance(r, dict) and r.get("id"): ids.add(str(r["id"]))
except FileNotFoundError:
    pass
def next_free(prefix):
    n = 0
    for i in ids:
        m = re.match("^" + prefix + r"([1-9][0-9]*)$", i)
        if m: n = max(n, int(m.group(1)))
    return "%s%d" % (prefix, n + 1)
poles = [x for x in os.environ["HPOLES"].split("|") if x]
example = "horos aporia %s %s %s %s" % (next_free("A"),
                                        shlex.quote("|".join(poles) if len(poles) >= 2 else "<pole1>|<pole2>"),
                                        shlex.quote(os.environ["HWHY"]), shlex.quote(os.environ["HTRIG"]))
if not re.match(r"^A[1-9][0-9]*$", rid):
    raise SystemExit("error: HOROS-CLI-BADID '%s' 는 A<n> 형식이 아닙니다 (not of the form A<n>; nothing was recorded). "
                     "Action: rerun with the suggested free id. 예: %s" % (rid, example))
if rid in ids:
    raise SystemExit("error: HOROS-CLI-DUPID %s 는 ledger에 이미 존재합니다 (already exists — appending again would silently shadow the original). "
                     "다음 빈 ID (next free): %s. Action: rerun with the suggested free id. 예: %s"
                     % (rid, next_free("A"), example))
if len(poles) < 2:
    raise SystemExit("error: HOROS-CLI-BADKIND 아포리아는 극(pole)이 2개 이상이어야 합니다 (needs >=2 poles, got %d; poles are '|'-separated in ONE quoted arg). "
                     "Action: rerun with both poles in the second argument. 예: %s" % (len(poles), example))
rec = {"id": rid, "type": "aporia", "poles": poles,
       "why_unresolved": os.environ["HWHY"], "trigger": os.environ["HTRIG"],
       "files": [x for x in os.environ.get("HFILES", "").split(",") if x],
       "date": datetime.datetime.now(datetime.timezone.utc).isoformat()}
raw = json.dumps(rec, ensure_ascii=False)
if horos_core:
    horos_core.locked_append(led, raw)
else:
    with open(led, "a", encoding="utf-8") as f:
        fcntl.flock(f.fileno(), fcntl.LOCK_EX)
        f.write(raw + "\n")
print("recorded %s (aporia) -> %s" % (rec["id"], led))
PY
    ;;

  claim)
    sub="${1:-}"
    case "$sub" in
      show)  cat "$S/claims.jsonl" 2>/dev/null || echo "(no claims)"; exit 0 ;;
      clear) rm -f "$S/claims.jsonl"; echo "claims cleared"; exit 0 ;;
    esac
    kind="$sub"; assertion="${2:-}"; files="${3:-}"; refs="${4:-}"; flags="${5:-}"
    case "$kind" in completion|consistency) ;; *)
      echo "error: HOROS-CLI-BADKIND '$kind' 는 claim 종류가 아닙니다 (unknown claim kind; allowed: completion, consistency)." >&2
      echo "usage: horos claim <completion|consistency> <assert> <files,csv> [refs,csv] [true_flags,csv]" >&2
      echo "       horos claim show | clear" >&2; exit 1 ;; esac
    if [ -z "$assertion" ] || [ -z "$files" ]; then
      echo "usage: horos claim <completion|consistency> <assert> <files,csv> [refs,csv] [true_flags,csv]" >&2; exit 1; fi
    warn_root
    PYTHONPATH="$HERE" HCLAIMS="$S/claims.jsonl" HROOT="$ROOT" HLEDGER="$ROOT/decisions.jsonl" HKIND="$kind" HASSERT="$assertion" HFILES="$files" HREFS="$refs" HFLAGS="$flags" python3 - <<'PY'
import datetime, difflib, fcntl, hashlib, json, os, re
try:
    import horos_core
except Exception:
    horos_core = None

path = os.environ["HCLAIMS"]; ROOT = os.environ["HROOT"]
KNOWN_FLAGS = ("tests_added", "consistent_with_refs")
flags = [x for x in os.environ.get("HFLAGS", "").split(",") if x]
bad = [x for x in flags if x not in KNOWN_FLAGS and not x.startswith("x_")]
if bad:
    hints = []
    for b in bad:
        m = difflib.get_close_matches(b, KNOWN_FLAGS, n=1, cutoff=0.6)
        hints.append(b + (" -> did you mean '%s'?" % m[0] if m else ""))
    raise SystemExit("error: HOROS-CLI-BADFLAG 알 수 없는 true-flag 입니다 (unknown flag would silently disable its invariant check): %s. "
                     "허용(known): %s; 확장(extension): x_*. Action: fix the flag name and rerun."
                     % ("; ".join(hints), ", ".join(KNOWN_FLAGS)))
refs = [x for x in os.environ.get("HREFS", "").split(",") if x]
badref = [r for r in refs if not re.match(r"^[DA][1-9][0-9]*$", r)]
if badref:
    raise SystemExit("error: HOROS-CLI-BADREF refs 형식 오류 (must be D<n> or A<n>): %s. "
                     "Action: fix the ref ids and rerun." % ", ".join(badref))
ledger = {}
try:
    with open(os.environ["HLEDGER"], encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line: continue
            try: r = json.loads(line)
            except Exception: continue
            if isinstance(r, dict) and r.get("id"): ledger[str(r["id"])] = r
except FileNotFoundError:
    pass
def complete(r):
    if horos_core:
        return horos_core.record_complete(r)
    if r.get("type") == "aporia":
        return bool(r.get("poles")) and all(str(r.get(k, "")).strip() for k in ("why_unresolved", "trigger"))
    return all(str(r.get(k, "")).strip() for k in ("why", "cost", "escape"))
noref = []
for r in refs:
    if r not in ledger: noref.append(r + "(미정의/undefined)")
    elif not complete(ledger[r]): noref.append(r + "(불완전/incomplete)")
if noref:
    first = noref[0].split("(")[0]
    fix = ("horos decide %s \"<why>\" \"<cost>\" \"<escape>\"" % first) if first.startswith("D") \
          else ("horos aporia %s \"<pole1>|<pole2>\" \"<why_unresolved>\" \"<trigger>\"" % first)
    raise SystemExit("error: HOROS-CLI-NOREF refs 가 ledger(decisions.jsonl)에 완비되어 있지 않습니다 (refs must exist and be complete BEFORE the claim): %s. "
                     "Action: externalize the ref first, then rerun this claim. 예: %s" % (", ".join(noref), fix))
real_root = os.path.realpath(ROOT)
def norm_bind(p):
    if horos_core:
        inside, rel = horos_core.normalize_relpath(p, ROOT)
        return (inside, rel)
    rp = os.path.realpath(os.path.join(real_root, p))
    if rp.startswith(real_root + os.sep):
        return (True, rp[len(real_root) + 1:].replace(os.sep, "/"))
    return (False, p)
def sha(rel):
    try:
        with open(os.path.join(real_root, rel), "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()
    except OSError:
        return None
raw_files = [x for x in os.environ["HFILES"].split(",") if x]
normed = [norm_bind(f) for f in raw_files]
outside = [raw_files[i] for i, (ok, _) in enumerate(normed) if not ok]
if outside:
    raise SystemExit("error: HOROS-CLI-NOFILE 바인딩할 파일이 프로젝트 루트 밖입니다 (bind targets outside project root): " + ", ".join(outside))
files = [rel for _, rel in normed]
binds = {f: sha(f) for f in files}
missing = [f for f, h in binds.items() if h is None]
if missing:
    raise SystemExit("error: HOROS-CLI-NOFILE 바인딩할 파일을 찾을 수 없습니다 (bind targets missing on disk — write the changes to disk first, paths are ROOT-relative): "
                     + ", ".join(missing))
n = 0
if os.path.exists(path):
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line: continue
            try: r = json.loads(line)
            except Exception: continue
            i = str(r.get("id", "")) if isinstance(r, dict) else ""
            if i.startswith("C") and i[1:].isdigit(): n = max(n, int(i[1:]))
rec = {"id": "C%d" % (n + 1), "kind": os.environ["HKIND"], "assert": os.environ["HASSERT"],
       "evidence_files": files, "binds": binds,
       "refs": refs,
       "claims_true": {k: True for k in flags},
       "date": datetime.datetime.now(datetime.timezone.utc).isoformat()}
raw = json.dumps(rec, ensure_ascii=False)
if horos_core:
    horos_core.locked_append(path, raw)
else:
    with open(path, "a", encoding="utf-8") as f:
        fcntl.flock(f.fileno(), fcntl.LOCK_EX)
        f.write(raw + "\n")
print("recorded %s (%s, binds %d file(s)) -> %s" % (rec["id"], rec["kind"], len(files), path))
PY
    ;;

  install)
    # D12, D23, D28, D31 — deploy horos into a target project by REFERENCE for claude | agy | codex.
    harness=claude
    while [ "${1:-}" ]; do case "$1" in
      --harness) harness="${2:-claude}"; shift 2 ;;
      --harness=*) harness="${1#--harness=}"; shift ;;
      *) break ;;
    esac; done
    case "$harness" in claude|agy|codex) ;; *)
      echo "error: unknown harness '$harness' (allowed: claude, agy, codex)" >&2; exit 1 ;;
    esac
    target="${1:-}"
    [ -n "$target" ] || { echo "usage: horos install [--harness claude|agy|codex] <target-project-dir>" >&2; exit 1; }
    [ -d "$target" ] || { echo "error: not a directory: $target" >&2; exit 1; }
    if [ "$harness" = agy ]; then
      HOROS_SRC="$CENTRAL" HOROS_TARGET="$target" python3 - <<'PY'
import json, os
src = os.path.abspath(os.environ["HOROS_SRC"]); target = os.path.abspath(os.environ["HOROS_TARGET"])
home = os.path.expanduser("~")
portable = (src == home or src.startswith(home + os.sep))
rel = src[len(home):].lstrip("/") if portable else None
adapter = ('"$HOME/%s/hooks/agy-adapter.sh"' % rel) if portable else ('"%s/hooks/agy-adapter.sh"' % src)
# D31: Antigravity 2.0 wires SessionStart (once per session) + nested systemMessage step
block = {"horos": {
    "PreToolUse": [{"matcher": "*", "hooks": [
        {"type": "command", "command": adapter + " pre-tool", "timeout": 15}]}],
    "SessionStart": [
        {"type": "command", "command": adapter + " session-start", "timeout": 10}],
    "Stop": [
        {"type": "command", "command": adapter + " stop", "timeout": 20}]}}
cfgdir = os.path.join(target, ".agents"); os.makedirs(cfgdir, exist_ok=True)
cfgpath = os.path.join(cfgdir, "hooks.json")
cfg = {}
if os.path.exists(cfgpath):
    try: cfg = json.load(open(cfgpath, encoding="utf-8"))
    except Exception as e: raise SystemExit("error: target .agents/hooks.json is not valid JSON: %s" % e)
cfg.pop("horos", None)
cfg.update(block)
with open(cfgpath, "w", encoding="utf-8") as f:
    json.dump(cfg, f, ensure_ascii=False, indent=2); f.write("\n")
gi = os.path.join(target, ".gitignore")
lines = open(gi, encoding="utf-8").read().splitlines() if os.path.exists(gi) else []
if ".horos/" not in lines:
    with open(gi, "a", encoding="utf-8") as f:
        f.write(("\n" if (lines and lines[-1] != "") else "") + "# horos runtime state (machine-local)\n.horos/\n")
print("installed horos (agy, by reference) -> %s/.agents/hooks.json" % target)
print("  central adapter: %s" % (("$HOME/" + rel) if portable else src) + "/hooks/agy-adapter.sh")
print("  events         : PreToolUse (scope + reversibility) + SessionStart (brief) + Stop (finish + decision + claim)")
print("  activate       : horos init %s   (creates .horos opt-in marker; mode starts warn)" % target)
if not portable:
    print("  WARNING: central horos is not under $HOME — wrote an absolute path (may not resolve on another machine)")
print("  note           : Antigravity 2.0 SessionStart + terminationReason abort-safety enabled (D31)")
PY
      exit 0
    fi

    HOROS_SRC="$CENTRAL" HOROS_TARGET="$target" HOROS_H="$harness" python3 - <<'PY'
import json, os
src = os.path.abspath(os.environ["HOROS_SRC"])
target = os.path.abspath(os.environ["HOROS_TARGET"])
harness = os.environ["HOROS_H"]
home = os.path.expanduser("~")
portable = (src == home or src.startswith(home + os.sep))
rel = src[len(home):].lstrip("/") if portable else None
def srcpath(name):
    return ('"$HOME/%s/hooks/%s"' % (rel, name)) if portable else ('"%s/hooks/%s"' % (src, name))
def hookcmd(name):
    p = srcpath(name)
    return "[ -x %s ] && %s || true" % (p, p)
pre = [
    {"matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch",
     "hooks": [{"type": "command", "command": hookcmd("scope-guard.sh"), "timeout": 15}]},
    {"matcher": "Bash",
     "hooks": [{"type": "command", "command": hookcmd("reversibility-guard.sh"), "timeout": 15}]},
]
stop_hooks = [
    {"type": "command", "command": hookcmd("finish-the-work.sh"), "timeout": 15},
    {"type": "command", "command": hookcmd("decision-guard.sh"), "timeout": 15},
    {"type": "command", "command": hookcmd("claim-guard.sh"), "timeout": 20},
]
stop = [{"hooks": stop_hooks}] if harness == "codex" else [{"matcher": "*", "hooks": stop_hooks}]
sess = [
    {"matcher": "startup|resume|clear|compact", "hooks": [
        {"type": "command", "command": hookcmd("session-brief.sh"), "timeout": 10},
    ]},
]
BASENAMES = tuple(os.environ["HOROS_BASENAMES"].split())
def is_horos(entry):
    return any(any(b in h.get("command", "") for b in BASENAMES) for h in entry.get("hooks", []))

if harness == "codex":
    cfgdir = os.path.join(target, ".codex")
    cfgname = "hooks.json"
else:
    cfgdir = os.path.join(target, ".claude")
    cfgname = "settings.json"
os.makedirs(cfgdir, exist_ok=True)
cfgpath = os.path.join(cfgdir, cfgname)
cfg = {}
if os.path.exists(cfgpath):
    try:
        cfg = json.load(open(cfgpath, encoding="utf-8"))
    except Exception as e:
        raise SystemExit("error: target %s is not valid JSON: %s" % (cfgpath, e))
hooks = cfg.setdefault("hooks", {})
for ev in ("PreToolUse", "Stop", "SessionStart"):
    if ev in hooks:
        hooks[ev] = [e for e in hooks[ev] if not is_horos(e)]
hooks.setdefault("PreToolUse", []).extend(pre)
hooks.setdefault("Stop", []).extend(stop)
hooks.setdefault("SessionStart", []).extend(sess)
with open(cfgpath, "w", encoding="utf-8") as f:
    json.dump(cfg, f, ensure_ascii=False, indent=2); f.write("\n")
gi = os.path.join(target, ".gitignore")
lines = open(gi, encoding="utf-8").read().splitlines() if os.path.exists(gi) else []
if ".horos/" not in lines:
    with open(gi, "a", encoding="utf-8") as f:
        f.write(("\n" if (lines and lines[-1] != "") else "") + "# horos runtime state (machine-local)\n.horos/\n")
if harness == "codex":
    print("installed horos (codex, by reference) -> %s/.codex/hooks.json" % target)
    print("  central source : %s/hooks" % (("$HOME/" + rel) if portable else src))
    print("  enforcement    : scope-guard (incl. apply_patch) + reversibility-guard + finish/decision/claim")
    print("  trust gate     : approve project hooks via `/hooks` in Codex CLI if prompted (D28)")
else:
    print("installed horos (by reference) -> %s" % target)
    print("  central source : %s/hooks" % (("$HOME/" + rel) if portable else src))
    print("  enforcement    : scope-guard, reversibility-guard (PreToolUse) + finish/decision/claim (Stop)")
    print("  protocol       : session-brief (SessionStart) — injects the conventions card each session")
if not portable:
    print("  WARNING: central horos is not under $HOME — wrote an absolute path that may not resolve")
    print("           on another machine. Move horos under $HOME for multimachine portability.")
print("  verify         : horos doctor %s" % target)
print("  note           : hooks load at session start — mode starts warn.")
PY
    ;;

  init)
    target="${1:-$ROOT}"
    [ -d "$target" ] || { echo "error: not a directory: $target" >&2; exit 1; }
    mkdir -p "$target/.horos"
    [ -f "$target/.horos/mode" ] || printf 'warn\n' > "$target/.horos/mode"
    gi="$target/.gitignore"
    if ! grep -qxF '.horos/' "$gi" 2>/dev/null; then
      [ -s "$gi" ] && [ -n "$(tail -c1 "$gi" 2>/dev/null)" ] && printf '\n' >> "$gi"
      { echo "# horos runtime state (machine-local)"; echo ".horos/"; } >> "$gi"
    fi
    echo "initialized horos activation marker -> $target/.horos (mode=warn, gitignored)"
    echo "  plugin      : hooks engage next session IF the horos plugin is enabled"
    echo "  no plugin?  : horos install $target  (reference wiring, no plugin needed)"
    echo "  verify      : horos doctor $target"
    ;;

  uninstall)
    # D20, D32 — strip horos reference wiring for claude | agy | codex | all.
    harness=claude
    while [ "${1:-}" ]; do case "$1" in
      --harness) harness="${2:-claude}"; shift 2 ;;
      --harness=*) harness="${1#--harness=}"; shift ;;
      *) break ;;
    esac; done
    case "$harness" in claude|agy|codex|all) ;; *)
      echo "error: unknown harness '$harness' (allowed: claude, agy, codex, all)" >&2; exit 1 ;;
    esac
    target="${1:-}"
    [ -n "$target" ] || { echo "usage: horos uninstall [--harness claude|agy|codex|all] <target-project-dir>" >&2; exit 1; }
    [ -d "$target" ] || { echo "error: not a directory: $target" >&2; exit 1; }
    HOROS_TARGET="$target" HOROS_H="$harness" python3 - <<'PY'
import json, os
target = os.path.abspath(os.environ["HOROS_TARGET"])
harness = os.environ["HOROS_H"]
BASENAMES = tuple(os.environ["HOROS_BASENAMES"].split())

def is_horos(entry):
    return any(any(b in h.get("command", "") for b in BASENAMES) for h in entry.get("hooks", []))

def clean_hook_map(cfgpath, label):
    if not os.path.exists(cfgpath):
        if harness != "all":
            print("nothing to remove (no %s)" % label)
        return
    try:
        cfg = json.load(open(cfgpath, encoding="utf-8"))
    except Exception as e:
        raise SystemExit("error: target %s is not valid JSON: %s" % (label, e))
    hooks = cfg.get("hooks") or {}
    removed = 0
    for ev in list(hooks.keys()):
        kept = [e for e in hooks[ev] if not is_horos(e)]
        removed += len(hooks[ev]) - len(kept)
        if kept:
            hooks[ev] = kept
        else:
            del hooks[ev]
    if not hooks and "hooks" in cfg:
        del cfg["hooks"]
    with open(cfgpath, "w", encoding="utf-8") as f:
        json.dump(cfg, f, ensure_ascii=False, indent=2); f.write("\n")
    print("removed %d horos hook entr%s -> %s" % (removed, "y" if removed == 1 else "ies", cfgpath))

def clean_agy(cfgpath):
    if not os.path.exists(cfgpath):
        if harness != "all":
            print("nothing to remove (no .agents/hooks.json)")
        return
    try:
        cfg = json.load(open(cfgpath, encoding="utf-8"))
    except Exception as e:
        raise SystemExit("error: target .agents/hooks.json is not valid JSON: %s" % e)
    had = 1 if "horos" in cfg else 0
    cfg.pop("horos", None)
    with open(cfgpath, "w", encoding="utf-8") as f:
        json.dump(cfg, f, ensure_ascii=False, indent=2); f.write("\n")
    print("removed %d horos hook group -> %s" % (had, cfgpath))

if harness in ("claude", "all"):
    clean_hook_map(os.path.join(target, ".claude", "settings.json"), ".claude/settings.json")
if harness in ("codex", "all"):
    clean_hook_map(os.path.join(target, ".codex", "hooks.json"), ".codex/hooks.json")
if harness in ("agy", "all"):
    clean_agy(os.path.join(target, ".agents", "hooks.json"))
print("  note: hooks unload next session; .horos/ marker kept (plugin takes over if enabled)")
PY
    ;;

  prune)
    # D32 — bound unbounded runtime growth in .horos/ (violations.log, claims.jsonl, agy_changed.*, guards).
    days=14; prune_all=0; target=""
    while [ "${1:-}" ]; do case "$1" in
      --days) days="${2:-14}"; shift 2 ;;
      --days=*) days="${1#--days=}"; shift ;;
      --all) prune_all=1; shift ;;
      *) target="$1"; shift ;;
    esac; done
    PT="${target:-$ROOT}"; PS="$PT/.horos"
    PYTHONPATH="$HERE" HP_STATE="$PS" HP_DAYS="$days" HP_ALL="$prune_all" python3 - <<'PY'
import os, horos_core
res = horos_core.prune_runtime(
    os.environ["HP_STATE"],
    keep_days=int(os.environ["HP_DAYS"]),
    prune_all=(os.environ["HP_ALL"] == "1"),
)
print(
    "pruned %s -> violations_dropped=%d (kept=%d) claims_dropped=%d agy_temp_removed=%d guards_reset=%d"
    % (
        os.environ["HP_STATE"],
        res["violations_dropped"],
        res["violations_kept"],
        res["claims_dropped"],
        res["agy_temp_removed"],
        res["guards_reset"],
    )
)
PY
    ;;

  log)    tail -n "${1:-20}" "$S/violations.log" 2>/dev/null || echo "(no violations logged)" ;;

  doctor)
    DT="${1:-$ROOT}"; DS="$DT/.horos"
    dmode=""; [ -f "$DS/mode" ] && dmode="$(tr -d '[:space:]' < "$DS/mode" 2>/dev/null)"; [ -n "$dmode" ] || dmode=warn
    echo "root : $DT"
    echo "vers : $([ -f "$CENTRAL/VERSION" ] && tr -d '[:space:]' < "$CENTRAL/VERSION" 2>/dev/null || echo unknown)"
    echo "plugn: $([ -f "$CENTRAL/.claude-plugin/plugin.json" ] && echo "packaged (.claude-plugin)" || echo "not packaged")"
    echo "activ: $([ -d "$DS" ] && echo ".horos present (plugin-eligible)" || echo ".horos absent — run: horos init $DT")"
    if grep -qE 'scope-guard\.sh|parent-bridge\.sh' "$DT/.claude/settings.json" 2>/dev/null; then
      echo "prece: local-settings (reference wiring wins; plugin defers, D20)"
    else
      echo "prece: plugin (engages if enabled + marker present)"
    fi
    echo "mode : $dmode"
    echo "scope: $([ -f "$DS/scope.json" ] && echo declared || echo none)"
    echo "decns: $([ -f "$DT/decisions.jsonl" ] && tr -cd '\n' < "$DT/decisions.jsonl" | wc -c | tr -d ' ' || echo 0) recorded"
    echo "claim: $([ -f "$DS/claims.jsonl" ] && tr -cd '\n' < "$DS/claims.jsonl" | wc -c | tr -d ' ' || echo 0) deposited (runtime)"
    echo "skill: $([ -f "$DT/.claude/skills/contract-first/SKILL.md" ] && echo contract-first || echo none) (philosophy 1)"
    HOROS_DT="$DT" python3 - <<'PY'
import json, os, re
dt = os.path.abspath(os.environ["HOROS_DT"])
harnesses = []
cmds = []
drifts = []

def inspect_claude_like(relpath, tag):
    p = os.path.join(dt, relpath)
    if not os.path.exists(p):
        return
    try:
        cfg = json.load(open(p, encoding="utf-8"))
    except Exception:
        drifts.append("%s: invalid JSON" % relpath)
        return
    found = False
    for ev, entries in (cfg.get("hooks") or {}).items():
        for e in entries:
            matcher = str(e.get("matcher") or "")
            for hk in e.get("hooks", []):
                c = str(hk.get("command") or "")
                if c:
                    cmds.append(c)
                if "scope-guard.sh" in c or "parent-bridge.sh" in c:
                    found = True
                    missing_m = [t for t in ("NotebookEdit", "apply_patch") if t not in matcher]
                    if missing_m:
                        drifts.append("%s: edit matcher missing %s (refresh with: horos install%s %s)"
                                      % (relpath, "|".join(missing_m),
                                         " --harness codex" if tag == "codex" else "", dt))
    if found:
        harnesses.append(tag)

inspect_claude_like(".claude/settings.json", "claude")
inspect_claude_like(".codex/hooks.json", "codex")

agyp = os.path.join(dt, ".agents", "hooks.json")
agy_adapter = None
if os.path.exists(agyp):
    try:
        acfg = json.load(open(agyp, encoding="utf-8"))
        hb = acfg.get("horos")
        if isinstance(hb, dict):
            harnesses.append("agy")
            if "PreInvocation" in hb and "SessionStart" not in hb:
                drifts.append(".agents/hooks.json: uses legacy PreInvocation instead of SessionStart (refresh with: horos install --harness agy %s)" % dt)
            for entries in hb.values():
                for e in entries:
                    if isinstance(e, dict) and "hooks" in e:
                        for hk in e["hooks"]:
                            c = str(hk.get("command") or "")
                            m = re.search(r'"([^"]*agy-adapter\.sh)"', c)
                            if m: agy_adapter = os.path.expandvars(os.path.expanduser(m.group(1)))
                    elif isinstance(e, dict) and "command" in e:
                        c = str(e.get("command") or "")
                        m = re.search(r'"([^"]*agy-adapter\.sh)"', c)
                        if m: agy_adapter = os.path.expandvars(os.path.expanduser(m.group(1)))
    except Exception:
        drifts.append(".agents/hooks.json: invalid JSON")

clip = os.path.join(dt, ".horos", "cli.path")
if os.path.isfile(clip):
    raw_cli = open(clip, encoding="utf-8").read().strip()
    if raw_cli and not os.access(raw_cli, os.X_OK):
        drifts.append(".horos/cli.path: points to non-executable path (%s)" % raw_cli)

print("harns: %s" % (", ".join(harnesses) if harnesses else "none (plugin or local hooks only)"))
print("hooks:")

def ref_path(name):
    for c in cmds:
        if name in c:
            m = re.search(r'"([^"]*' + re.escape(name) + r')"', c)
            if m:
                return os.path.expandvars(os.path.expanduser(m.group(1)))
    if agy_adapter:
        cand = os.path.join(os.path.dirname(agy_adapter), name)
        if os.path.exists(cand):
            return cand
    return None

for h in ("scope-guard", "reversibility-guard", "finish-the-work", "decision-guard", "claim-guard"):
    name = h + ".sh"
    local = os.path.join(dt, "hooks", name)
    if os.access(local, os.X_OK):
        print("  [OK] %-22s local" % h)
    else:
        rp = ref_path(name)
        if rp and os.access(rp, os.X_OK):
            print("  [OK] %-22s ref %s" % (h, os.path.dirname(rp)))
        else:
            print("  [MISS] %-20s" % h)

if drifts:
    print("drift:")
    for d in drifts:
        print("  [DRIFT] %s" % d)
PY
    echo "health:"
    if [ -f "$DS/violations.log" ]; then
      awk -F'\t' '{ c = ($5 != "") ? $5 : "(uncoded/" $3 ")"; n[c]++ } END { for (k in n) printf "  %5d  %s\n", n[k], k }' \
        "$DS/violations.log" 2>/dev/null | sort -rn
      tel="$(grep -c 'HOROS-TEL-' "$DS/violations.log" 2>/dev/null || true)"
      if [ "${tel:-0}" -gt 0 ] 2>/dev/null; then echo "  silent-pass traces: $tel (HOROS-TEL-*)"; fi
      echo "  total: $(wc -l < "$DS/violations.log" | tr -d ' ') line(s)"
    else
      echo "  (no violations logged)"
    fi
    ;;

  help|*)
    cat <<'EOF'
horos — agent discipline harness (philosophies 1/2/3/4/5)
  horos scope set <glob>...   declare the editable boundary             (philosophy 3)
  horos scope show | clear
  horos mode warn|block|strict|show  staged enforcement toggle (strict: warn-tier도 block + 루프가드 4회, D18)
  horos decide D<n> <why> <cost> <escape> [files]   externalize a decision  (philosophy 2)
  horos aporia A<n> "<p1>|<p2>" <why_unresolved> <trigger> [files]   externalize a held tension (philosophy 2)
  horos claim <completion|consistency> <assert> <files,csv> [refs] [flags]   deposit a verifiable claim (audit tier)
  horos claim show | clear
  horos install [--harness claude|agy|codex] <target>   wire a project by reference, no copy (D12/D23/D28/D31)
  horos init [target]         plugin-era opt-in: create .horos marker + mode=warn + gitignore (D19)
  horos uninstall [--harness claude|agy|codex|all] <target>   strip reference wiring (D20/D32)
  horos prune [--days N | --all] [target]   prune aged runtime logs/claims/temp files (D32)
  horos log [N]               recent violations
  horos doctor [target]       installation check (wiring, harnesses, drift, version, health)
EOF
    ;;
esac
